<mjml>
  <mj-head>
    <mj-title>Normandy Park Historical Society</mj-title>
    <mj-attributes>
      <mj-all font-family="'Source Serif 4', Georgia, 'Times New Roman', serif"></mj-all>
      <mj-text color="#2B2723" font-size="17px" line-height="1.62" padding="0 32px"></mj-text>
      <mj-class name="mono" font-family="'IBM Plex Mono', Menlo, Consolas, monospace"></mj-class>
      <mj-class name="display" font-family="'Josefin Sans', 'Trebuchet MS', Arial, sans-serif"></mj-class>
    </mj-attributes>
    <mj-style inline="inline">
      a { color: #2F5F7E; text-decoration: underline; }
      .nphs-footer a { color: #234A63; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#FAF7F1" width="600px">
    <!-- Web view link -->
    <mj-section padding="16px 0">
      <mj-column>
        <mj-text mj-class="mono" font-size="14px" color="#5B5349" align="center">{webview_text}</mj-text>
      </mj-column>
    </mj-section>

    <!-- Masthead: solid Harbor band, wordmark only (no emblem exists) -->
    <mj-section background-color="#2F5F7E" padding="28px 0">
      <mj-column>
        <mj-text mj-class="mono" font-size="13px" letter-spacing="0.1em" text-transform="uppercase" color="#FAF7F1" padding-bottom="8px">Newsletter</mj-text>
        <mj-text mj-class="display" font-size="28px" font-weight="700" line-height="1.1" color="#FAF7F1">Normandy Park Historical Society</mj-text>
      </mj-column>
    </mj-section>

    <!-- Body: replace with this issue's content -->
    <mj-section background-color="#FFFFFF" padding="32px 0" border-left="1px solid #DCD3C2" border-right="1px solid #DCD3C2">
      <mj-column>
        <mj-text mj-class="mono" font-size="13px" letter-spacing="0.1em" text-transform="uppercase" color="#A9502F" padding-bottom="8px">From the archive</mj-text>
        <mj-text mj-class="display" font-size="26px" font-weight="600" line-height="1.15" padding-bottom="16px">Headline for this issue</mj-text>
        <mj-text padding-bottom="24px">Write the opening paragraph here. Keep it plain and specific to Normandy Park, and link to the full story on the website.</mj-text>
        <mj-button href="https://normandyparkhs.org" mj-class="mono" background-color="#2F5F7E" color="#FAF7F1" font-size="14px" letter-spacing="0.04em" border-radius="2px" inner-padding="14px 24px" align="left" padding="0 32px">Read the full story</mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer: same content as the website footer -->
    <mj-section background-color="#EAE3D5" padding="28px 0" border-top="1px solid #DCD3C2" css-class="nphs-footer">
      <mj-column>
        <mj-text mj-class="display" font-size="19px" font-weight="600" color="#2F5F7E" padding-bottom="8px">Normandy Park Historical Society</mj-text>
        <mj-text font-size="15px" color="#5B5349" padding-bottom="12px">A Washington State 501(c)(3) nonprofit keeping the record of Normandy Park: photographs, documents, places, people and the stories that connect them.</mj-text>
        <mj-text mj-class="mono" font-size="14px" line-height="1.6" color="#5B5349" padding-bottom="16px">PO Box 0001, Normandy Park, WA 98166<br />
          EIN 42-5178856<br />
          <a href="mailto:info@normandyparkhs.org">info@normandyparkhs.org</a> · <a href="https://normandyparkhs.org">normandyparkhs.org</a></mj-text>
        <mj-divider border-width="1px" border-color="#DCD3C2" padding="0 32px 16px"></mj-divider>
        <mj-text font-size="14px" color="#5B5349" padding-bottom="8px">Material is published with its provenance. To request a correction or the removal of an identification, <a href="https://normandyparkhs.org/privacy#corrections">write to us</a>.</mj-text>
        <mj-text font-size="14px" color="#5B5349">You are receiving this because you signed up for the Society's newsletter. {unsubscribe_text}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
